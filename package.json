{
  "name": "@hyperjump/browser",
  "version": "2.0.0-dev",
  "description": "A client for working with JSON Reference (`$ref`) documents",
  "keywords": [
    "$ref",
    "jref",
    "hypermedia",
    "browser",
    "client"
  ],
  "author": "Jason Desrosiers <jdesrosi@gmail.com>",
  "license": "MIT",
  "repository": "github:hyperjump-io/browser",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hyperjump-io"
  },
  "type": "module",
  "exports": {
    ".": "./src/hyperjump/index.js",
    "./json": "./src/json/index.js",
    "./jref": "./src/jref/index.js"
  },
  "imports": {
    "#context-uri": {
      "node": "./src/hyperjump/context-uri.js",
      "default": "./src/hyperjump/context-uri.browser.js"
    },
    "#default-uri-scheme-plugins": {
      "node": "./src/hyperjump/uri-schemes/default-uri-scheme-plugins.js",
      "default": "./src/hyperjump/uri-schemes/default-uri-scheme-plugins.browser.js"
    },
    "#file-scheme-plugin": {
      "node": "./src/hyperjump/uri-schemes/file-scheme-plugin.js",
      "default": "./src/hyperjump/uri-schemes/file-scheme-plugin.browser.js"
    },
    "#path-to-uri": {
      "node": "./src/jref/path-to-uri.js",
      "default": "./src/jref/path-to-uri.browser.js"
    }
  },
  "bin": {
    "rejson": "./src/json/rejson-cli.js",
    "jref": "./src/jref/jref-cli.js"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "docs": "typedoc --excludeExternals"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "*",
    "@types/content-type": "*",
    "@types/moo": "*",
    "@types/node": "*",
    "@vitest/coverage-v8": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typedoc": "*",
    "typescript": "*",
    "undici": "*",
    "vite": "*",
    "vitest": "*"
  },
  "dependencies": {
    "@hyperjump/json-pointer": "^1.1.1",
    "@hyperjump/uri": "^1.3.0",
    "@types/unist": "^3.0.3",
    "content-type": "^1.0.5",
    "moo": "^0.5.2",
    "unified": "^11.0.5",
    "unified-args": "^11.0.1",
    "vfile-message": "^4.0.3"
  }
}
