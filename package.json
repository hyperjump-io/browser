{
  "name": "@hyperjump/browser",
  "version": "2.0.0-dev",
  "description": "A client for working with JSON Reference (`$ref`) documents",
  "keywords": [
    "$ref",
    "jref",
    "hypermedia",
    "browser",
    "client"
  ],
  "author": "Jason Desrosiers <jdesrosi@gmail.com>",
  "license": "MIT",
  "repository": "github:hyperjump-io/browser",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hyperjump-io"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/",
    "!**/*.test.js",
    "!src/json/jsonast-util-tests/"
  ],
  "exports": {
    ".": {
      "types": "./src/hyperjump/index.d.ts",
      "default": "./src/hyperjump/index.js"
    }
  },
  "imports": {
    "#context-url": {
      "node": "./src/hyperjump/context-url.js",
      "default": "./src/hyperjump/context-url.browser.js"
    },
    "#default-http-cache": {
      "node": "./src/hyperjump/url-schemes/default-http-cache.js",
      "default": "./src/hyperjump/url-schemes/default-http-cache.browser.js"
    },
    "#default-url-scheme-plugins": {
      "node": "./src/hyperjump/url-schemes/default-url-scheme-plugins.js",
      "default": "./src/hyperjump/url-schemes/default-url-scheme-plugins.browser.js"
    },
    "#file-http-cache-store": {
      "node": "./src/hyperjump/url-schemes/file-http-cache-store.js",
      "default": "./src/hyperjump/url-schemes/file-http-cache-store.browser.js"
    },
    "#file-scheme-plugin": {
      "node": "./src/hyperjump/url-schemes/file-scheme-plugin.js",
      "default": "./src/hyperjump/url-schemes/file-scheme-plugin.browser.js"
    },
    "#path-to-url": {
      "node": "./src/json/path-to-url.js",
      "default": "./src/json/path-to-url.browser.js"
    },
    "#real-url": {
      "node": "./src/hyperjump/real-url.js",
      "default": "./src/hyperjump/real-url.browser.js"
    },
    "#redirect-mode": {
      "node": "./src/hyperjump/url-schemes/redirect-mode.js",
      "default": "./src/hyperjump/url-schemes/redirect-mode.browser.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "version": "node scripts/version-docs.js && git add website"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "*",
    "@types/node": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": "*",
    "undici": "*",
    "vite": "*",
    "vitest": "*"
  },
  "dependencies": {
    "@hyperjump/json-pointer": "^2.0.0",
    "@types/unist": "^3.0.3",
    "content-type": "^3.1.1",
    "http-cache-semantics": "^4.3.0",
    "unified": "^11.0.5",
    "vfile-message": "^4.0.4"
  }
}
