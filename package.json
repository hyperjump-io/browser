{
  "name": "@hyperjump/browser",
  "version": "2.0.0-dev",
  "description": "A hypermedia browser that retrieves documents like a web browser: sessions, a stack of layers, an HTTP cache, and file: URLs on the server",
  "keywords": [
    "hypermedia",
    "fetch",
    "http-cache",
    "browser",
    "client",
    "layers"
  ],
  "author": "Jason Desrosiers <jdesrosi@gmail.com>",
  "license": "MIT",
  "repository": "github:hyperjump-io/browser",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hyperjump-io"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "src/",
    "!**/*.test.js",
    "!**/*.test-d.ts",
    "!src/test-helpers/",
    "!src/json/jsonast-util-tests/",
    "!**/node_modules/"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "imports": {
    "#context-url": {
      "node": "./src/context-url.js",
      "default": "./src/context-url.browser.js"
    },
    "#default-stack": {
      "node": "./src/default-stack.js",
      "default": "./src/default-stack.browser.js"
    },
    "#path-to-url": {
      "node": "./src/json/path-to-url.js",
      "default": "./src/json/path-to-url.browser.js"
    },
    "#real-url": {
      "node": "./src/real-url.js",
      "default": "./src/real-url.browser.js"
    },
    "#file-scheme": {
      "node": "./src/transports/file-scheme.js",
      "default": "./src/transports/file-scheme.browser.js"
    },
    "#node-transport": {
      "node": "./src/transports/node-transport.js",
      "default": "./src/transports/node-transport.browser.js"
    },
    "#http-cache": {
      "node": "./src/http-cache/http-cache.js",
      "default": "./src/http-cache/http-cache.browser.js"
    },
    "#file-cache-store": {
      "node": "./src/http-cache/file-cache-store.js",
      "default": "./src/http-cache/file-cache-store.browser.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "version": "node scripts/version-docs.js && git add website"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "*",
    "@types/node": "*",
    "har-validator": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": "*",
    "unist-util-visit": "*",
    "vfile-message": "^4.0.4",
    "vite": "*",
    "vitest": "*"
  },
  "dependencies": {
    "@hyperjump/json-pointer": "^2.0.1",
    "@hyperjump/pact": "^2.0.1",
    "@types/unist": "^3.0.3",
    "unified": "^11.0.5"
  }
}
